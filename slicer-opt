#!/bin/sh
# Run the tool from a checkout without installing it. Needs Python 3.10 or newer;
# set PYTHON to choose one, otherwise the first suitable python3 is used.
here="$(cd "$(dirname "$0")" && pwd)"
for candidate in "$PYTHON" /opt/homebrew/bin/python3 /usr/local/bin/python3 python3.14 python3.13 python3.12 python3.11 python3.10 python3; do
  [ -n "$candidate" ] || continue
  if command -v "$candidate" >/dev/null 2>&1 &&
     "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
    PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" exec "$candidate" -m slicer_optimizer "$@"
  fi
done
echo "slicer-opt: needs Python 3.10 or newer (set PYTHON=/path/to/python3)" >&2
exit 2
